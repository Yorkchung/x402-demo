# Restart all services after editing .env.local.
WEB_PORT=3000
RESOURCE_PORT=3001
WEB_ORIGIN=http://127.0.0.1:3000
RESOURCE_SERVER_URL=http://127.0.0.1:3001

# UI / local API default to Demo; choose Base Sepolia in the UI for real settlement.
# X402_MODE sets the base configuration for directly used server factories.
X402_MODE=testnet
X402_NETWORK=eip155:84532
X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# REQUIRED for testnet. Set your public receiving address; never a private key.
X402_PAY_TO=
X402_AMOUNT=10000
X402_TOKEN_DECIMALS=6
X402_TIMEOUT_SECONDS=300
X402_UPSTREAM_FACILITATOR_URL=https://x402.org/facilitator
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SETTLEMENT_STATE_PATH=.data/settlements.json

# Server-only service authentication. Replace for your local installation.
# Used only when X402_MODE=mock; never use a wallet private key.
DEMO_SIGNING_SECRET=local-demo-signing-secret-change-me
SERVER_TIMEOUT_MS=60000
DEMO_LATENCY_MS=350
